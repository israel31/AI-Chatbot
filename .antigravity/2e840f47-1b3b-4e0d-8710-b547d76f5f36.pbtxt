llback: true\n+      });\n     }\n-\n-    return res.json(parsed);\n   } catch (error: any) {\n     console.error(\"Error handling /api/query:\", error);\n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown.The following action was requested:\nCreate new file /src/services/localGroundingService.tsThe action produced the following result:\nThe following changes were made by an unspecified tool call (nil ToolCall) to: /src/services/localGroundingService.ts.\n[diff_block_start]\n@@ -0,0 +1,185 @@\n+import { DocumentItem, Citation } from \'../types\';\n+\n+export interface LocalQueryResult {\n+  isGrounded: boolean;\n+  answer: string;\n+  citations: Citation[];\n+  confidenceScore: number;\n+  searchedDocs: string[];\n+  status?: \'grounded\' | \'not_found\' | \'error\';\n+}\n+\n+/**\n+ * Strict deterministic local grounding search engine.\n+ * Used when remote LLM service experiences transient 503 high demand spikes or network unavailability,\n+ * ensuring zero downtime and 100% adherence to internal document-only guardrails.\n+ */\n+export function searchDocumentationLocally(\n+  query: string,\n+  documents: DocumentItem[],\n+  strictMode: boolean = true\n+): LocalQueryResult {\n+  const cleanQuery = query.toLowerCase().trim();\n+  const docTitles = documents.map(d => d.title);\n+\n+  if (!cleanQuery) {\n+    return {\n+      isGrounded: false,\n+      answer: \"Please provide a question about internal company documentation.\",\n+      citations: [],\n+      confidenceScore: 0,\n+      searchedDocs: docTitles,\n+      status: \'not_found\'\n+    };\n+  }\n+\n+  // Extract meaningful query tokens\n+  const stopWords = new Set([\n+    \'what\', \'is\', \'our\', \'the\', \'for\', \'are\', \'how\', \'do\', \'we\', \'does\', \'a\', \'an\',\n+    \'in\', \'to\', \'of\', \'and\', \'or\', \'can\', \'i\', \'get\', \'my\', \'about\', \'with\', \'on\', \'at\'\n+  ]);\n+\n+  const rawTokens = cleanQuery\n+    .replace(/[^a-z0-9\\s-]/g, \' \')\n+    .split(/\\s+/)\n+    .filter(t => t.length > 1 && !stopWords.has(t));\n+\n+  interface MatchedSection {\n+    doc: DocumentItem;\n+    heading: string;\n+    text: string;\n+    score: number;\n+    matchedKeywords: string[];\n+  }\n+\n+  const matchedSections: MatchedSection[] = [];\n+\n+  for (const doc of documents) {\n+    // Split document by markdown headings or double newlines into logical sections\n+    const rawBlocks = doc.content.split(/\\n(?=#{1,4}\\s+|\\d+\\.\\s+)/);\n+\n+    for (const block of rawBlocks) {\n+      const trimmed = block.trim();\n+      if (!trimmed) continue;\n+\n+      const lines = trimmed.split(\'\\n\');\n+      const firstLine = lines[0].trim();\n+      const heading = firstLine.startsWith(\'#\')\n+        ? firstLine.replace(/^#+\\s*/, \'\')\n+        : `${doc.title}`;\n+      const blockBody = lines.join(\'\\n\');\n+      const lowerBlock = blockBody.toLowerCase();\n+\n+      let score = 0;\n+      const matchedKeywords: string[] = [];\n+\n+      for (const token of rawTokens) {\n+        if (lowerBlock.includes(token)) {\n+          score += 2;\n+          matchedKeywords.push(token);\n+          // Bonus for token appearing in section heading or doc title\n+          if (heading.toLowerCase().includes(token) || doc.title.toLowerCase().includes(token)) {\n+            score += 3;\n+          }\n+        }\n+      }\n+\n+      // Check phrase matches\n+      if (cleanQuery.length > 5 && lowerBlock.includes(cleanQuery)) {\n+        score += 10;\n+      }\n+\n+      if (score >= 4 || (rawTokens.length <= 2 && score >= 2)) {\n+        matchedSections.push({\n+          doc,\n+          heading,\n+          text: trimmed,\n+          score,\n+          matchedKeywords\n+        });\n+      }\n+    }\n+  }\n+\n+  // Sort matches by relevance score descending\n+  matchedSections.sort((a, b) => b.score - a.score);\n+\n+  // If no credible match found in the provided documentation\n+  if (matchedSections.length === 0 || matchedSections[0].score < 2) {\n+    return {\n+      isGrounded: false,\n+      answer: `I cannot answer this question based on the provided internal company documentation.\\n\\nThe requested information regarding \"${query.trim()}\" is not documented in any of the active internal policies (${docTitles.join(\', \')}). Under strict security protocols, I am prohibited from guessing, hallucinating, or accessing external web sources.`,\n+      citations: [],\n+      confidenceScore: 0,\n+      searchedDocs: docTitles,\n+      status: \'not_found\'\n+    };\n+  }\n+\n+  const bestMatch = matchedSections[0];\n+  const citations: Citation[] = [];\n+\n+  // Extract exact quote excerpt\n+  const sentences = bestMatch.text.split(/(?<=[.?!])\\s+/);\n+  let quoteExcerpt = \"\";\n+  for (const s of sentences) {\n+    const lowerS = s.toLowerCase();\n+    if (rawTokens.some(t => lowerS.includes(t))) {\n+      quoteExcerpt = s.trim();\n+      break;\n+    }\n+  }\n+  if (!quoteExcerpt) {\n+    quoteExcerpt = bestMatch.text.slice(0, 180).trim() + \"...\";\n+  }\n+\n+  citations.push({\n+    documentId: bestMatch.doc.id,\n+    documentTitle: bestMatch.doc.title,\n+    sectionHeading: bestMatch.heading,\n+    exactQuote: quoteExcerpt,\n+    confidenceScore: Math.min(0.98, 0.65 + (bestMatch.score * 0.05))\n+  });\n+\n+  // Include secondary citation if available from same or related doc\n+  if (matchedSections.length > 1 && matchedSections[1].doc.id !== bestMatch.doc.id) {\n+    const sec = matchedSections[1];\n+    citations.push({\n+      documentId: sec.doc.id,\n+      documentTitle: sec.doc.title,\n+      sectionHeading: sec.heading,\n+      exactQuote: sec.text.slice(0, 140).trim() + \"...\",\n+      confidenceScore: Math.min(0.92, 0.6 + (sec.score * 0.04))\n+    });\n+  }\n+\n+  // Formulate clear, grounded response synthesizing the matched internal documentation\n+  const docName = bestMatch.doc.title.split(\',\')[0];\n+  const mainContentClean = bestMatch.text\n+    .replace(/^#+\\s*/gm, \'### \')\n+    .trim();\n+\n+  let formattedAnswer = `According to **${docName}**`;\n+  if (bestMatch.heading && bestMatch.heading !== docName) {\n+    formattedAnswer += ` (*${bestMatch.heading}*)`;\n+  }\n+  formattedAnswer += `:\\n\\n${mainContentClean}\\n\\n`;\n+\n+  if (matchedSections.length > 1 && matchedSections[1].doc.id !== bestMatch.doc.id) {\n+    const sec = matchedSections[1];\n+    formattedAnswer += `\\n**Additional Reference from ${sec.doc.title.split(\',\')[0]}:**\\n${sec.text.slice(0, 250).trim()}...`;\n+  }\n+\n+  const finalConfidence = Math.min(0.99, 0.70 + (bestMatch.score * 0.05));\n+\n+  return {\n+    isGrounded: true,\n+    answer: formattedAnswer,\n+    citations,\n+    confidenceScore: finalConfidence,\n+    searchedDocs: docTitles,\n+    status: \'grounded\'\n+  };\n+}\n+\n+\n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown.The following action was requested:\nRunning linter...The action produced the following result:\nLinting completed successfully\nOutput:\n\n> react-example@0.0.0 lint\n> tsc --noEmit\n\nThe following action was requested:\nBuilding applet...The action produced the following result:\nBuild succeeded - the applet is compiledThe following action was requested:\nRestarting dev server...The action produced the following result:\nDev server restarted successfully"
