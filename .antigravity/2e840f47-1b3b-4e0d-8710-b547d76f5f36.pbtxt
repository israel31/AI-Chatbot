          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    summary: \'Rules for booking domestic and international flights, per diem meal limits, hotel tier maximums, and Expensify submission deadlines.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tags: [\'travel\', \'meals\', \'per diem\', \'hotels\', \'flights\', \'expenses\', \'reimbursement\'],"
