        }
        lines {
          text: "    content: `# Customer Escalations, Severity Levels & Incident Response Matrix"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Document ID:** DOC-OPS-005 | **Classification:** Internal Operations | **Custodian:** SRE & CS Operations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. Incident Severity Definitions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **P0 - Catastrophic Outage:** Complete platform unavailability or data loss affecting >25% of active customers or any Tier-1 enterprise account during business hours."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **P1 - Major Core Feature Outage:** Critical system functionality unavailable (e.g., checkout API failing, authentication down for a subset of regions) with no immediate workaround."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **P2 - Degraded Performance / Workaround Available:** Subsystem slowness, non-critical feature outage, or UI latency with an operational workaround."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **P3 - Minor Issue / Cosmetic Defect:** Low impact bug, typo, styling flaw, or single-user intermittent edge case."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. Incident Response & Communication SLAs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Severity | Initial Response SLA | Status Page Update Cadence | Internal Exec Briefing |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| :--- | :--- | :--- | :--- |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **P0** | **< 15 minutes** | Every 30 minutes | Within 30 mins |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **P1** | **< 30 minutes** | Every 60 minutes | Within 2 hours |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **P2** | **< 2 hours** | On resolution / daily | Daily summary |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **P3** | **< 24 hours** | Release notes | Weekly sprint review |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 3. Incident Commander & War Room Procedures"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Automated War Room:** For any P0 or P1 incident, the on-call SRE immediately invokes the Slack workflow \\`/incident create\\`, which spins up a dedicated incident channel \\`#inc-YYYYMMDD-service\\` and a Google Meet war room link."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Roles:** The Incident Commander (IC) leads triage; the Communications Lead manages customer status page postings; the Tech Lead directs debugging."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Root Cause Analysis (RCA) Policy:** An un-blamable Post-Incident Review (PIR) and RCA document must be published and reviewed within 5 business days for all P0 and P1 events.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
