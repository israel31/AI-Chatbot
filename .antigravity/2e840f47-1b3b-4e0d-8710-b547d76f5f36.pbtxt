  file_change {
    absolute_path_uri: "file:///src/components/ChatMessageItem.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport Markdown from \'react-markdown\';\nimport {\n  ShieldCheck,\n  AlertTriangle,\n  FileText,\n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n  Copy,\n  Check,\n  PlusCircle,\n  Quote,\n  CheckCircle2,\n  Clock,\n  Sparkles,\n  Info\n} from \'lucide-react\';\nimport { ChatMessage, Citation } from \'../types\';\n\ninterface ChatMessageItemProps {\n  message: ChatMessage;\n  onViewDoc: (docId: string, highlightQuote?: string) => void;\n  onOpenAddDocWithGap?: (query: string) => void;\n  onReportGap?: (query: string) => void;\n}\n\nexport const ChatMessageItem: React.FC<ChatMessageItemProps> = ({\n  message,\n  onViewDoc,\n  onOpenAddDocWithGap,\n  onReportGap,\n}) => {\n  const [copied, setCopied] = useState(false);\n  const [showAllCitations, setShowAllCitations] = useState(false);\n  const isUser = message.role === \'user\';\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(message.content);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  if (isUser) {\n    return (\n      <div className=\"flex justify-end my-4\">\n        <div className=\"max-w-2xl bg-slate-900 text-white rounded-2xl rounded-tr-xs px-5 py-3.5 shadow-sm\">\n          <p className=\"text-sm font-normal leading-relaxed whitespace-pre-wrap\">{message.content}</p>\n          <div className=\"flex items-center justify-end gap-1 mt-1 text-[11px] text-slate-400\">\n            <span>{new Date(message.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}</span>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  const isGrounded = message.status === \'grounded\' && (message.citations?.length ?? 0) > 0;\n  const isNotFound = message.status === \'not_found\' || (!isGrounded && message.status !== \'error\');\n\n  return (\n    <div className=\"flex flex-col my-4 max-w-3xl\">\n      <div\n        className={`rounded-2xl border transition-all ${\n          isNotFound\n            ? \'bg-amber-50/40 border-amber-200/90 shadow-xs\'\n            : message.status === \'error\'\n            ? \'bg-red-50/50 border-red-200\'\n            : \'bg-white border-slate-200/90 shadow-sm\'\n        } p-5`}\n      >\n        {/* Verification Status Header */}\n        <div className=\"flex flex-wrap items-center justify-between gap-2 pb-3.5 mb-3.5 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            {isNotFound ? (\n              <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-300/80\">\n                <AlertTriangle className=\"w-3.5 h-3.5 text-amber-700\" />\n                Information Not in Documentation\n              </span>\n            ) : message.status === \'error\' ? (\n              <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800\">\n                Processing Notice\n              </span>\n            ) : (\n              <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-900 border border-emerald-300/80\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-700\" />\n                Strict Internal Grounding Verified\n              </span>\n            )}\n\n            {message.confidenceScore !== undefined && message.confidenceScore > 0 && (\n              <span className=\"text-[11px] font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md\">\n                Match: {Math.round(message.confidenceScore * 100)}%\n              </span>\n            )}\n          </div>\n\n          <div className=\"flex items-center gap-1.5\">\n            <button\n              id={`copy-btn-${message.id}`}\n              onClick={handleCopy}\n              className=\"text-slate-400 hover:text-slate-600 p-1.5 rounded-md hover:bg-slate-100 transition-colors\"\n              title=\"Copy response\"\n            >\n              {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n            </button>\n            <span className=\"text-[11px] text-slate-400\">\n              {new Date(message.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n            </span>\n          </div>\n        </div>\n\n        {/* Answer Content */}\n        <div className=\"prose prose-sm prose-slate max-w-none text-slate-800 leading-relaxed\">\n          <Markdown>{message.content}</Markdown>\n        </div>\n\n        {/* Citations Section for Grounded Answers */}\n        {isGrounded && message.citations && message.citations.length > 0 && (\n          <div className=\"mt-4 pt-3.5 border-t border-slate-100\">\n            <div className=\"flex items-center justify-between mb-2\">\n              <span className=\"text-xs font-semibold text-slate-700 flex items-center gap-1.5\">\n                <Quote className=\"w-3.5 h-3.5 text-indigo-600\" />\n                Verified Citations ({message.citations.length})\n              </span>\n              {message.citations.length > 2 && (\n                <button\n                  onClick={() => setShowAllCitations(!showAllCitations)}\n                  className=\"text-xs text-indigo-600 hover:text-indigo-700 font-medium flex items-center gap-0.5\"\n                >\n                  {showAllCitations ? (\n                    <>\n                      Show less <ChevronUp className=\"w-3 h-3\" />\n                    </>\n                  ) : (\n                    <>\n                      Show all ({message.citations.length}) <ChevronDown className=\"w-3 h-3\" />\n                    </>\n                  )}\n                </button>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              {(showAllCitations ? message.citations : message.citations.slice(0, 2)).map((citation, idx) => (\n                <div\n                  key={idx}\n                  className=\"group bg-slate-50 hover:bg-slate-100/90 rounded-xl p-3 border border-slate-200/80 transition-colors\"\n                >\n                  <div className=\"flex items-center justify-between gap-2 mb-1.5\">\n                    <button\n                      onClick={() => onViewDoc(citation.documentId, citation.exactQuote)}\n                      className=\"text-xs font-semibold text-slate-900 hover:text-indigo-600 flex items-center gap-1.5 text-left transition-colors\"\n                    >\n                      <FileText className=\"w-3.5 h-3.5 text-slate-500 group-hover:text-indigo-600\" />\n                      <span>{citation.documentTitle}</span>\n                      {citation.sectionHeading && (\n                        <span className=\"text-slate-400 font-normal\">\342\206\222 {citation.sectionHeading}</span>\n                      )}\n                    </button>\n                    <button\n                      onClick={() => onViewDoc(citation.documentId, citation.exactQuote)}\n                      className=\"text-[11px] text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity\"\n                    >\n                      <span>Inspect</span>\n                      <ExternalLink className=\"w-3 h-3\" />\n                    </button>\n                  </div>\n                  <blockquote className=\"text-xs text-slate-600 italic bg-white/80 rounded-lg p-2 border-l-2 border-indigo-400 pl-2.5 my-1\">\n                    \"{citation.exactQuote}\"\n                  </blockquote>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* Not Found / Out of Scope Guidance & Action Box */}\n        {isNotFound && (\n          <div className=\"mt-4 pt-3.5 border-t border-amber-200/60\">\n            <div className=\"bg-amber-100/60 rounded-xl p-3.5 border border-amber-200 text-xs text-amber-900 space-y-2\">\n              <div className=\"flex items-start gap-2\">\n                <Info className=\"w-4 h-4 text-amber-700 shrink-0 mt-0.5\" />\n                <div>\n                  <p className=\"font-semibold text-amber-950\">Security & Compliance Guarantee:</p>\n                  <p className=\"mt-0.5 text-amber-800 leading-relaxed\">\n                    This assistant strictly operates on internal company records. It is prohibited from querying Google, Wikipedia, or outside websites to prevent data contamination or unverified answers.\n                  </p>\n                </div>\n              </div>\n\n              {message.searchedDocs && message.searchedDocs.length > 0 && (\n                <div className=\"mt-2 text-[11px] text-amber-800/90 pt-1 border-t border-amber-200/80\">\n                  <span className=\"font-medium\">Documents verified: </span>\n                  {message.searchedDocs.join(\', \')}\n                </div>\n              )}\n\n              <div className=\"flex flex-wrap items-center gap-2 pt-2\">\n                {onOpenAddDocWithGap && (\n                  <button\n                    onClick={() => onOpenAddDocWithGap(message.content)}\n                    className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-800 text-white font-medium hover:bg-amber-900 text-xs shadow-xs transition-colors\"\n                  >\n                    <PlusCircle className=\"w-3.5 h-3.5\" />\n                    <span>Upload/Draft Missing Document</span>\n                  </button>\n                )}\n                {onReportGap && (\n                  <button\n                    onClick={() => onReportGap(message.content)}\n                    className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white text-amber-900 font-medium hover:bg-amber-50 border border-amber-300 text-xs transition-colors\"\n                  >\n                    <AlertTriangle className=\"w-3.5 h-3.5 text-amber-700\" />\n                    <span>Log as Knowledge Gap</span>\n                  </button>\n                )}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
      replacement_content: "import React, { useState } from \'react\';\nimport Markdown from \'react-markdown\';\nimport {\n  ShieldCheck,\n  AlertTriangle,\n  FileText,\n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n  Copy,\n  Check,\n  PlusCircle,\n  Quote,\n  Lock,\n  Info\n} from \'lucide-react\';\nimport { ChatMessage } from \'../types\';\n\ninterface ChatMessageItemProps {\n  message: ChatMessage;\n  onViewDoc: (docId: string, highlightQuote?: string) => void;\n  onOpenAddDocWithGap?: (query: string) => void;\n  onReportGap?: (query: string) => void;\n}\n\nexport const ChatMessageItem: React.FC<ChatMessageItemProps> = ({\n  message,\n  onViewDoc,\n  onOpenAddDocWithGap,\n  onReportGap,\n}) => {\n  const [copied, setCopied] = useState(false);\n  const [showAllCitations, setShowAllCitations] = useState(false);\n  const isUser = message.role === \'user\';\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(message.content);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  if (isUser) {\n    return (\n      <div className=\"flex gap-3 max-w-[85%] self-end flex-row-reverse my-2\">\n        {/* User Avatar */}\n        <div className=\"w-8 h-8 rounded-full bg-slate-700 text-white shrink-0 flex items-center justify-center text-xs font-bold shadow-2xs\">\n          JD\n        </div>\n        {/* User Bubble */}\n        <div className=\"flex flex-col items-end\">\n          <div className=\"bg-[#2563eb] text-white rounded-2xl rounded-tr-xs px-4 py-3 text-[14px] leading-relaxed shadow-2xs\">\n            <p className=\"whitespace-pre-wrap\">{message.content}</p>\n          </div>\n          <span className=\"text-[10px] text-slate-400 mt-1 px-1\">\n            {new Date(message.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n          </span>\n        </div>\n      </div>\n    );\n  }\n\n  const isGrounded = message.status === \'grounded\' && (message.citations?.length ?? 0) > 0;\n  const isNotFound = message.status === \'not_found\' || (!isGrounded && message.status !== \'error\');\n\n  return (\n    <div className=\"flex gap-3 max-w-[88%] my-2 items-start\">\n      {/* AI Avatar */}\n      <div className=\"w-8 h-8 rounded-full bg-[#2563eb] text-white shrink-0 flex items-center justify-center text-xs font-bold shadow-2xs\">\n        AI\n      </div>\n\n      {/* AI Bubble & Metadata */}\n      <div className=\"flex-1 min-w-0\">\n        <div\n          className={`p-4 sm:p-5 rounded-2xl bg-white border text-[14.5px] leading-relaxed shadow-xs transition-all ${\n            isNotFound\n              ? \'border-slate-200 border-l-4 border-l-rose-500 bg-rose-50/20\'\n              : message.status === \'error\'\n              ? \'border-slate-200 border-l-4 border-l-amber-500 bg-amber-50/20\'\n              : \'border-slate-200\'\n          }`}\n        >\n          {/* Answer Content */}\n          <div className=\"prose prose-sm prose-slate max-w-none text-slate-800 leading-relaxed break-words font-normal\">\n            <Markdown>{message.content}</Markdown>\n          </div>\n\n          {/* Clean Attribution Line */}\n          {isGrounded && message.citations && message.citations.length > 0 && (\n            <div className=\"mt-3.5 pt-2.5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2\">\n              <div className=\"text-[12px] text-slate-500 italic flex items-center gap-1.5\">\n                <span className=\"w-2.5 h-2.5 rounded-xs bg-slate-300 inline-block shrink-0\"></span>\n                <span>\n                  Source:{\' \'}\n                  <strong className=\"font-semibold text-slate-700 not-italic\">\n                    {message.citations[0].documentTitle}\n                  </strong>{\' \'}\n                  {message.citations[0].sectionHeading && `\342\200\242 ${message.citations[0].sectionHeading}`}\n                </span>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <button\n                  id={`copy-btn-${message.id}`}\n                  onClick={handleCopy}\n                  className=\"text-slate-400 hover:text-slate-600 p-1 rounded hover:bg-slate-100 transition-colors\"\n                  title=\"Copy response\"\n                >\n                  {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* Refusal Notice Attribution */}\n          {isNotFound && (\n            <div className=\"mt-3 pt-2.5 border-t border-slate-100 text-[12px] text-slate-500 italic flex items-center justify-between\">\n              <span>No relevant documentation found in internal Knowledge Base.</span>\n              <button\n                id={`copy-btn-${message.id}`}\n                onClick={handleCopy}\n                className=\"text-slate-400 hover:text-slate-600 p-1 rounded hover:bg-slate-100 transition-colors\"\n                title=\"Copy response\"\n              >\n                {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              </button>\n            </div>\n          )}\n\n          {/* Citations Inspector Drawer */}\n          {isGrounded && message.citations && message.citations.length > 0 && (\n            <div className=\"mt-2.5 pt-2.5 border-t border-slate-100\">\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-[11px] font-semibold text-slate-600 uppercase tracking-wider flex items-center gap-1\">\n                  <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  Verified Excerpts ({message.citations.length})\n                </span>\n                {message.citations.length > 1 && (\n                  <button\n                    onClick={() => setShowAllCitations(!showAllCitations)}\n                    className=\"text-[11px] text-[#2563eb] hover:underline font-medium flex items-center gap-0.5\"\n                  >\n                    {showAllCitations ? (\n                      <>\n                        Show less <ChevronUp className=\"w-3 h-3\" />\n                      </>\n                    ) : (\n                      <>\n                        View all <ChevronDown className=\"w-3 h-3\" />\n                      </>\n                    )}\n                  </button>\n                )}\n              </div>\n\n              <div className=\"space-y-1.5\">\n                {(showAllCitations ? message.citations : message.citations.slice(0, 1)).map((citation, idx) => (\n                  <div\n                    key={idx}\n                    className=\"group bg-slate-50 hover:bg-slate-100/90 rounded-lg p-2.5 border border-slate-200/80 transition-colors text-xs\"\n                  >\n                    <div className=\"flex items-center justify-between gap-2 mb-1\">\n                      <span className=\"font-semibold text-slate-800 text-[12px] flex items-center gap-1\">\n                        <FileText className=\"w-3 h-3 text-slate-400\" />\n                        {citation.documentTitle}\n                      </span>\n                      <button\n                        onClick={() => onViewDoc(citation.documentId, citation.exactQuote)}\n                        className=\"text-[11px] text-[#2563eb] hover:text-[#1d4ed8] font-medium flex items-center gap-0.5 transition-colors\"\n                      >\n                        <span>Inspect in Document</span>\n                        <ExternalLink className=\"w-3 h-3\" />\n                      </button>\n                    </div>\n                    <blockquote className=\"text-[11.5px] text-slate-600 italic bg-white rounded p-2 border-l-2 border-[#2563eb] pl-2 my-0.5\">\n                      \"{citation.exactQuote}\"\n                    </blockquote>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* Missing Doc Actions for Refusals */}\n          {isNotFound && (\n            <div className=\"mt-3 pt-2.5 border-t border-slate-100 flex flex-wrap items-center gap-2\">\n              {onOpenAddDocWithGap && (\n                <button\n                  onClick={() => onOpenAddDocWithGap(message.content)}\n                  className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-[#2563eb] text-white text-[11px] font-medium hover:bg-[#1d4ed8] transition-colors shadow-2xs\"\n                >\n                  <PlusCircle className=\"w-3 h-3\" />\n                  <span>Draft Policy for this Gap</span>\n                </button>\n              )}\n              {onReportGap && (\n                <button\n                  onClick={() => onReportGap(message.content)}\n                  className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-medium transition-colors border border-slate-200\"\n                >\n                  <AlertTriangle className=\"w-3 h-3 text-amber-600\" />\n                  <span>Track Missing Doc</span>\n                </button>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
