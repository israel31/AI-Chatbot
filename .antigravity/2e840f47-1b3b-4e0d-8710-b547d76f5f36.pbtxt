        lines {
          text: "    content: `# Engineering Standards, Code Reviews & Deployment Windows"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Document ID:** DOC-ENG-003 | **Effective Date:** February 2026 | **Custodian:** Engineering Council"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. Pull Request & Code Review SLAs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Review Turnaround Time:** Pull requests must receive an initial code review within 24 business hours of submission. Urgent bug fixes tagged \\`[P0-Fix]\\` must be reviewed within 2 hours."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Required Approvals:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Standard Microservices: Minimum 1 peer code review approval from a code owner in the \\`CODEOWNERS\\` file."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Core Auth, Billing, and Data Pipeline Services: Minimum 2 approvals, including at least one Senior or Staff Staff Engineer."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Automated Checks:** All CI/CD pipelines must pass 100% of linting, type-checking, and automated regression suites prior to merge."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. Test Coverage & Quality Gates"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Unit Test Coverage:** New code merged into main branches must maintain or increase total test coverage, with a hard minimum of 85% branch coverage for business logic in domain packages."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Integration Testing:** Any change altering an external REST or gRPC contract must include an updated end-to-end contract test suite."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 3. Production Deployment Windows & Freeze Periods"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Authorized Deployment Windows:** Production releases are permitted exclusively Tuesday through Thursday between 10:00 AM EST and 3:00 PM EST."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Deployment Freezes:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Friday / Weekend Freeze:** Deployments are prohibited from Friday 12:00 PM EST through Monday 9:00 AM EST to preserve service stability."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Holiday Freeze:** End-of-year deployment freeze runs from December 15 through January 5 annually."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Emergency Override:** Emergency hotfixes during freeze windows require explicit two-party approval from the VP of Engineering and the incident commander."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 4. Zero-Downtime Database Migrations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Expand/Contract Pattern:** Database schema migrations must never introduce breaking column drops or renames in a single step. All schema changes must follow the 3-phase Expand, Migrate, Contract lifecycle with backwards compatibility for the previous two application versions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 5. On-Call Responsibilities & Pager Duty SLA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Primary On-Call Response Time:** Must acknowledge and begin triage on P0/P1 alerts within 15 minutes 24/7. Secondary backup is automatically paged if unacknowledged after 20 minutes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **On-Call Compensation:** Engineers receive $450 per week of primary on-call rotation plus 1.5x hourly equivalent for active remediation time beyond scheduled working hours.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
