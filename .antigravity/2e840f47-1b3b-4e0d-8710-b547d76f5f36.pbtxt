          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `# Corporate Travel, Meals & Expense Reimbursement Guidelines"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Document ID:** DOC-FIN-004 | **Audience:** All Global Employees | **Owner:** Finance Department"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. Flight Booking & Travel Classes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Domestic Flights (under 6 hours):** Must be booked in standard Economy / Main Cabin via the corporate travel portal (Navan). Economy Plus / Extra Legroom is approved for employees taller than 6\'2\" or with documented medical needs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **International Flights & Long-Haul:** Business Class (or Premium Economy if Business is unavailable) is permitted only for non-stop flights exceeding 6 continuous flight hours, subject to Director-level pre-approval."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Advance Booking:** Flights must be booked at least 14 days in advance of departure unless responding to an urgent customer escalation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. Daily Meal Allowances (Per Diem)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Domestic US Travel:** Maximum daily meal reimbursement is $85 USD per full travel day (allocated as $20 Breakfast, $25 Lunch, $40 Dinner). No itemized split is required as long as the total daily aggregate does not exceed $85."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **International Travel & High-Cost Metro (SF, NYC, London, Zurich, Tokyo):** Maximum daily meal allowance is $120 USD per full travel day."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Alcohol Policy:** Alcoholic beverages are reimbursable up to a maximum of $25 per day as part of dinner meals, provided meals are consumed during legitimate business travel."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 3. Lodging & Hotel Nightly Caps"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Standard Tier Cities:** Maximum reimbursable room rate is $250 USD per night (excluding mandatory city taxes and resort fees)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **High-Cost Tier 1 Cities (New York, San Francisco, Boston, London, Paris, Tokyo):** Maximum room rate is $350 USD per night."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Airbnb / Short-Term Rentals:** Approved only for stays exceeding 4 consecutive nights and when the total cost is at least 15% lower than the equivalent corporate hotel rate."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 4. Expense Submission Deadlines & Receipts"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Submission Window:** All expense reports must be submitted via Expensify within 30 calendar days of the transaction date or travel completion date."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Receipt Threshold:** Itemized receipts are mandatory for any single transaction exceeding $25 USD. Credit card statements without itemized receipts are not accepted for meal or lodging expenses.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
