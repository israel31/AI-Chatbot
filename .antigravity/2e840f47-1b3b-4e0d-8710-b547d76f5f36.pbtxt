        }
        lines {
          text: "    content: `# SOC 2 Information Security, Access Control & BYOD Policy"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Document ID:** DOC-SEC-002 | **Classification:** Tier 2 - Internal Confidential | **Owner:** Information Security"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. Authentication & Password Standards"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Password Complexity:** Passwords must be a minimum of 16 characters in length generated by the company-provided 1Password Enterprise vault. Passwords expire every 180 days if not managed via SSO."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Hardware Multi-Factor Authentication (MFA):** All access to production AWS/GCP cloud environments, GitHub repositories, and customer databases strictly requires FIDO2/WebAuthn hardware security keys (YubiKey 5 Series). SMS or email OTP verification is strictly prohibited for engineering and infrastructure tier access."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Screen Lock Timeout:** All workstations must be configured with an automatic screen lock triggered after 5 minutes of inactivity."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. Data Classification Levels"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Tier 1 - Public:** Marketing materials, public documentation, open-source repositories."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Tier 2 - Internal Confidential:** Internal communication, strategy roadmaps, financial projections, architectural diagrams."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Tier 3 - Restricted (PII/Financial):** Customer personal identifiable information (PII), payment credentials, hashed passwords, production encryption secrets. Tier 3 data must be encrypted at rest with AES-256 and in transit via TLS 1.3."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 3. Security Incident Reporting & Escalation Protocol"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Reporting Window:** Any suspected security anomaly, lost device, credential leak, or unauthorized access attempt MUST be reported within 30 minutes of discovery."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Designated Channels:** Submit directly to \\`security@company.internal\\` or page the on-call security engineer in the private Slack channel \\`#sec-incident-hotline\\`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Public Disclosure Prohibition:** Employees are strictly prohibited from discussing or sharing potential security vulnerabilities or breaches on external social media, personal channels, or customer-facing forums without written authorization from Legal and the CISO."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 4. Bring Your Own Device (BYOD) & Mobile Device Management (MDM)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Workstation Mandate:** Company-issued MacBooks or ThinkPads managed through Kandji/Jamf MDM must be used for all primary engineering, sales, and executive work."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Disk Encryption:** Full-disk encryption (FileVault for macOS, BitLocker for Windows) must remain enabled at 100% capacity at all times."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Personal Mobile Devices:** Accessing work email (Google Workspace) or Slack from personal mobile devices requires enrollment in the company MDM with remote-wipe permissions for company containers.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
