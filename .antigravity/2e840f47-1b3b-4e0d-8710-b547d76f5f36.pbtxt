          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    summary: \'Defines incident severity tiers (P0-P3), customer communication cadence, executive war room triggers, and Root Cause Analysis (RCA) deadlines.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
