        lines {
          text: "    content: `# Employee Benefits, Leave & Remote Work Policy (2026)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Document ID:** DOC-HR-001 | **Effective Date:** January 1, 2026 | **Custodian:** People Operations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. Paid Time Off (PTO) & Holidays"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Accrual Rate:** Full-time regular employees accrue 20 days (160 hours) of Paid Time Off per calendar year, accrued semi-monthly on each payroll cycle (6.67 hours per pay period)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Rollover Limits:** A maximum of 5 unused PTO days may roll over into the subsequent calendar year. Any additional unused PTO beyond 5 days is forfeited on December 31 at 11:59 PM EST."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Floating Holidays & Company Holidays:** The company observes 11 standard federal holidays plus 2 additional floating personal holidays per calendar year."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Bereavement Leave:** Up to 5 consecutive paid business days for immediate family members (spouse, child, parent, sibling), and 3 days for extended family."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. Retirement & 401(k) Employer Match"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Eligibility:** All employees are eligible for the company 401(k) plan through Vanguard starting on their first full calendar month of employment."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Match Calculation:** The company matches 100% of employee contributions up to the first 4% of eligible base salary, and 50% on the next 2% of salary. The maximum total employer matching contribution is 5.0% of base salary."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Vesting Schedule:** All employer matching contributions are 100% immediately vested from day one (immediate vesting)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 3. Health, Dental & Vision Insurance"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Medical Provider:** UnitedHealthcare Choice Plus (HDHP with HSA contribution of $1,000/individual or $2,000/family paid by company annually) or PPO 500 Plan."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Dental & Vision:** Delta Dental Premier ($2,000 annual max) and VSP Vision Care (annual eye exam 100% covered, $200 frame allowance)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Wellness & Fitness Reimbursement:** $75 gross monthly allowance via Expensify under category \"Wellness\" for gym memberships, fitness classes, or mental health subscriptions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 4. Parental & Caregiver Leave"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Paid Parental Leave:** All new parents (birth, adoption, foster placement, gestational carrier), regardless of gender or primary/secondary designation, are entitled to 16 continuous weeks of 100% base-salary paid leave."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Eligibility:** Must have completed at least 90 calendar days of active full-time service prior to the qualifying event."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Gradual Return-to-Work:** Employees may opt for an 80% schedule (4 days/week) at 100% full pay for the first 4 weeks following return from parental leave."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 5. Remote Work & Equipment Stipend"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Home Office Setup Stipend:** New hires receive a one-time, non-taxable $1,000 technology and ergonomic furniture allowance reimbursable within the first 60 days of employment."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Monthly Internet & Utility Subsidy:** $60 net per month automatically added to the secondary monthly payroll paycheck for all designated remote/hybrid employees."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Core Collaboration Hours:** Remote teams are expected to be available for real-time synchronous collaboration during core team hours: 10:00 AM to 3:00 PM in their local home time zone (EST/CST/PST).`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
