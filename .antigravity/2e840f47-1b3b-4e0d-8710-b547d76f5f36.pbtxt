        }
        lines {
          text: "    summary: \'Standard release stages, canary rollout percentage gates, LaunchDarkly feature flag hygiene, and instant rollback procedures.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
